{
  "name": "talk",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev:up": "docker compose -f docker-compose.dev.yml --env-file .env.dev up -d --wait",
    "dev:down": "docker compose -f docker-compose.dev.yml --env-file .env.dev down",
    "dev": "node scripts/dev.mjs",
    "dev:admin": "npm run dev:admin -w server --",
    "backup": "node scripts/backup-local.mjs",
    "build": "npm run build -w web",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces"
  }
}
