# Variáveis do ambiente de DESENVOLVIMENTO local. Copie para .env.dev (que não vai para o git):
#   cp .env.dev.example .env.dev
# As senhas abaixo são só para o Docker local (portas presas em 127.0.0.1). Nunca use em produção.

# Docker (docker-compose.dev.yml)
POSTGRES_PASSWORD=dev-postgres
POSTGRES_TALK_PASSWORD=dev-talk
POSTGRES_EVOLUTION_PASSWORD=dev-evolution
EVOLUTION_API_KEY=dev-evolution-api-key-0123456789abcdef

# App (npm run dev) — o servidor roda dentro da pasta server/, por isso os caminhos ../
PORT=3000
DATABASE_URL=postgres://talk:dev-talk@localhost:54329/talk
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
WEBHOOK_SECRET=dev-webhook-secret-0123456789abcdef0123456789abcdef
EVOLUTION_URL=http://localhost:8081
WEBHOOK_BASE_URL=http://host.docker.internal:3000
MEDIA_DIR=../data/dev-media
# Vazio: as telas são servidas pelo Vite (http://localhost:5173), não pelo servidor.
WEB_DIST_DIR=
